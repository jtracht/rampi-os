#!/bin/sh
set -eu
# Resolve once so binary and design assets come from the same selected version.
release="$(readlink -f /opt/rampi/current)"
case "$release" in /opt/rampi/*) ;; *) echo 'Ungültige Installation.' >&2; exit 1 ;; esac
export RAMPI_ASSETS="$release/assets"
exec "$release/rampi-native" "$@"
