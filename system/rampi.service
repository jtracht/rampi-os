[Unit]
Description=Rampi graphical workstation
After=graphical-session-pre.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rampi
Restart=on-failure
RestartSec=3
# Remain an ordinary user; trusted system tools may request explicit polkit/PAM authorization.
# NoNewPrivileges would prevent the user's console and pkexec from authenticating normally.
UMask=0077
Environment=GDK_BACKEND=wayland
Environment=GSK_RENDERER=cairo
Environment=SDL_VIDEODRIVER=wayland
