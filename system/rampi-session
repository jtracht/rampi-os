#!/bin/sh
set -eu
# LightDM owns Xorg, VT and PAM. Never start a second display server.
systemctl --user import-environment DISPLAY XAUTHORITY XDG_SESSION_TYPE
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_SESSION_TYPE
openbox --config-file /etc/xdg/rampi/openbox.xml &
wm_pid=$!
/usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1 &
agent_pid=$!
unclutter --hide-on-touch --timeout 2 &
cursor_pid=$!
trap 'systemctl --user stop rampi.service; kill "$wm_pid" "$agent_pid" "$cursor_pid" 2>/dev/null || true' EXIT HUP INT TERM
systemctl --user start rampi.service
wait "$wm_pid"
