#!/bin/sh
set -eu
export XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=Rampi
export GDK_BACKEND=wayland GSK_RENDERER=cairo SDL_VIDEODRIVER=wayland
unset DISPLAY XAUTHORITY
if [ -n "${WAYLAND_DISPLAY:-}" ]; then exec /usr/local/bin/rampi-wayland-start; fi
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then
    exec dbus-run-session -- labwc -C /etc/xdg/rampi/labwc -S /usr/local/bin/rampi-wayland-start
fi
exec labwc -C /etc/xdg/rampi/labwc -S /usr/local/bin/rampi-wayland-start
