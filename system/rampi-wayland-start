#!/bin/sh
set -eu
export GDK_BACKEND=wayland GSK_RENDERER=cairo SDL_VIDEODRIVER=wayland
systemctl --user import-environment WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS GDK_BACKEND GSK_RENDERER SDL_VIDEODRIVER
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_CURRENT_DESKTOP GDK_BACKEND GSK_RENDERER SDL_VIDEODRIVER
gnome-keyring-daemon --start --components=secrets >/dev/null
trap 'systemctl --user stop rampi.service' EXIT HUP INT TERM
systemctl --user start --wait rampi.service
