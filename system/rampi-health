#!/bin/sh
set -eu
test -r /usr/share/wayland-sessions/rampi.desktop
test -r /etc/systemd/user/rampi.service
test -r /etc/xdg/rampi/labwc/rc.xml
test -x /opt/rampi/current/rampi-native
/opt/rampi/current/rampi-native --version
if ldd /opt/rampi/current/rampi-native | grep -q 'not found'; then
    echo 'Rust-Laufzeitbibliothek fehlt.' >&2; exit 1
fi
echo RAMPI_BOOT_OK
